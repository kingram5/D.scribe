# ───────────────────────────────────────────────────────────────────────────────
# D.Scribe — environment variables (template)
#
# Copy to `.env.local` and fill in real values. NEVER commit real secrets.
# `NEXT_PUBLIC_*` vars are exposed to the browser — never put a secret in one.
# Everything else is server-only. SUPABASE_SERVICE_ROLE_KEY bypasses RLS — guard it.
# (Generated from a grep of process.env across the codebase, 2026-06-01.)
# ───────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SERVER ONLY — bypasses Row Level Security

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                  # sk_test_... (test) / sk_live_... (prod)
STRIPE_WEBHOOK_SECRET=              # whsec_...
STRIPE_PRICE_STARTER=               # price_...
STRIPE_PRICE_PRO=                   # price_...
STRIPE_PRICE_PREMIUM=               # price_...
STRIPE_PRICE_VOICE_PACK=            # one-time price_... (+20,000 voice chars)
STRIPE_PRICE_INK_PACK=              # one-time price_... (+200 Ink)

# ── Cloudflare R2 (audio storage; S3-compatible) ──────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=dscribe-audio        # defaults to "dscribe-audio" if unset
R2_PUBLIC_DOMAIN=                   # optional — leave UNSET to keep audio private

# ── AI / transcription vendors ────────────────────────────────────────────────
ANTHROPIC_API_KEY=                  # Claude (analysis / generation)
DEEPGRAM_API_KEY=                   # audio transcription
ELEVENLABS_API_KEY=                 # TTS (Pro/Premium voice)
ELEVENLABS_VOICE_ID=                # defaults to a built-in voice if unset
SUPADATA_API_KEY=                   # YouTube transcript fetch
SEARCH_API_KEY=                     # Tavily (or Brave) — T.H.E.O background research. Absent = feature off.
SEARCH_API_PROVIDER=tavily          # tavily (default) or brave

# ── Observability ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=             # public — enables Sentry when set
AXIOM_TOKEN=                        # SERVER — structured logs in prod
AXIOM_DATASET=dscribe-logs          # defaults to "dscribe-logs"
# Needed only once `withSentryConfig` is wired (source-map upload) — see launch plan Phase 2:
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=               # e.g. https://d-scribe.app — used for Stripe redirect URLs
ALLOWED_EMAILS=                     # comma-separated beta allowlist (empty = deny all). Retire at public launch.
BLOG_ADMIN_KEY=                     # SERVER — auth key for the blog CMS write API

# ── Marketing pixels (optional — gate behind cookie consent before EU/CA traffic) ──
NEXT_PUBLIC_TIKTOK_PIXEL_ID=        # optional — omit to disable
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=    # optional — omit to disable

# ── Dev-only ──────────────────────────────────────────────────────────────────
WORKER_PORT=                        # only for the standalone dev worker (worker/analyze-worker.js); not used in prod

# ── Experimental mixed-provider Publisher-Ready (OFF by default) ─────────────
# See docs/mixed-stack-rollout.md. Server-side keys only; no NEXT_PUBLIC keys.
OPENAI_API_KEY=
ZAI_API_KEY=
GROQ_API_KEY=
PUBLISHER_READY_STACK=current
PUBLISHER_READY_MIXED_ENABLED=false
PUBLISHER_READY_MIXED_ACCOUNTS=
MIXED_ORGANIZE_MODEL=gpt-6-luna
MIXED_ANALYSIS_MODEL=glm-5.3
MIXED_BEATS_MODEL=glm-5.3-flash
MIXED_DRAFT_MODEL=claude-sonnet-5-5
MIXED_EDITOR_MODEL=glm-5.3
MIXED_PREMIUM_EDITOR_MODEL=claude-opus-5-5
MIXED_REVISION_MODEL=claude-sonnet-5-5
MIXED_CHECK_MODEL=gpt-6-luna
MIXED_AUDIT_PERCENT=10
# Explicit per-operation business-spend ceiling; no forecast price/budget default.
MIXED_MAX_OPERATION_USD=
# JSON keyed by provider/model: { evidence, price: { version, source, verifiedAt,
# input, output, cacheRead, cacheWrite, serviceTier: "default" } }. Prices / 1M tokens.
# Include cacheWrite1h for Claude and longContext for Luna (see observed prices).
# Evidence must document model access, payload compatibility and current prices.
MIXED_VERIFIED_MODELS_JSON=

# Uploaded audio is independent of text routing. Unknown/multiple speakers use Deepgram.
UPLOAD_TRANSCRIPTION_PROVIDER=current
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
GROQ_TRANSCRIPTION_ACCOUNTS=
# Only server-audited, single-speaker upload UUIDs. Large files remain on Deepgram.
GROQ_SINGLE_SPEAKER_UPLOAD_IDS=
GROQ_CAPABILITY_VERIFICATION=
# { version, source, verifiedAt, usdPerHour }; official pricing, not forecast rates.
GROQ_VERIFIED_PRICE_JSON=

# Live is independent of text routing. Requires a persistent supervisor and an
# explicitly approved live_chars_per_second row in existing ink_meter_settings.
THEO_VOICE_PROVIDER=current
THEO_LIVE_ACCOUNTS=
THEO_LIVE_MODEL=gpt-live-1
THEO_LIVE_VOICE=marin
THEO_BACKEND_MODEL=gpt-6-luna
THEO_LIVE_DIFFICULT_PLANNING=false
THEO_LIVE_BACKEND_MAX_USD=
THEO_LIVE_MAX_SECONDS=300
THEO_LIVE_CAPABILITY_VERIFICATION=
# { version, source, verifiedAt, usdPerMinute }; Live duration only, not delegation.
THEO_LIVE_VERIFIED_PRICE_JSON=
THEO_LIVE_SUPERVISOR_URL=
THEO_LIVE_SUPERVISOR_TOKEN=
THEO_LIVE_SUPERVISOR_HOST=127.0.0.1
THEO_LIVE_SUPERVISOR_PORT=3003
